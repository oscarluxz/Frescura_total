digraph ER {
graph [rankdir=LR,bgcolor="white",pad=0.5,nodesep=0.6,ranksep=1.2,splines=polyline,overlap=false,labelloc=t,fontname="Arial",fontsize=22,label="ERP Frescura Total — esquema completo\nPK: primaria | FK: foránea | UQ: única | ?: admite NULL\nCardinalidades explícitas en ambos extremos de cada relación"];
