digraph Domain {
graph [rankdir=LR,bgcolor="white",pad=0.4,nodesep=0.4,ranksep=1.5,splines=polyline,labelloc=t,fontname="Arial",fontsize=20,label="ERP Frescura Total — clases del dominio\nAtributos privados (-); operaciones públicas (+); enums sin duplicar valores\nFlecha continua: referencia de objeto | rombo blanco: colección agregada\nFlecha discontinua: asociación por identificador (sin referencia Java directa)"];
node [shape=plain,fontname="Arial",fontsize=11];
edge [fontname="Arial",fontsize=10,color="#52657A",arrowsize=0.7];
subgraph cluster_inventory { label="inventory/model"; color="#CBD5E0";
Inspection [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#D6F4E8"><B>Inspection</B></TD></TR><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- lotId : int</TD></TR><TR><TD ALIGN="LEFT">- inspectedAt : LocalDateTime</TD></TR><TR><TD ALIGN="LEFT">- result : String</TD></TR><TR><TD ALIGN="LEFT">- inspector : String</TD></TR><TR><TD ALIGN="LEFT">- rejectionReason : String</TD></TR><TR><TD ALIGN="LEFT">- notes : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
Lot [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#D6F4E8"><B>Lot</B></TD></TR><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- code : String</TD></TR><TR><TD ALIGN="LEFT">- productId : int</TD></TR><TR><TD ALIGN="LEFT">- supplierId : int</TD></TR><TR><TD ALIGN="LEFT">- receivedAt : LocalDateTime</TD></TR><TR><TD ALIGN="LEFT">- expirationDate : LocalDate</TD></TR><TR><TD ALIGN="LEFT">- initialQuantity : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- quantity : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- purchasePrice : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- salePrice : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- aisle : String</TD></TR><TR><TD ALIGN="LEFT">- shelf : String</TD></TR><TR><TD ALIGN="LEFT">- statusId : int</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
LotCustomer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#D6F4E8"><B>LotCustomer</B></TD></TR><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- name : String</TD></TR><TR><TD ALIGN="LEFT">- document : String</TD></TR><TR><TD ALIGN="LEFT">- deliveredQuantity : BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
LotStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#D6F4E8"><B>&lt;&lt;enum&gt;&gt; LotStatus</B></TD></TR><TR><TD ALIGN="LEFT">- databaseName : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ fromDatabaseName(String) : LotStatus<BR ALIGN="LEFT"/>+ forDate(LocalDate, LocalDate) : LotStatus<BR ALIGN="LEFT"/>+ allowsSale() : boolean</TD></TR></TABLE>>];
LotTrace [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#D6F4E8"><B>LotTrace</B></TD></TR><TR><TD ALIGN="LEFT">- lot : Lot</TD></TR><TR><TD ALIGN="LEFT">- productName : String</TD></TR><TR><TD ALIGN="LEFT">- supplierName : String</TD></TR><TR><TD ALIGN="LEFT">- supplierNit : String</TD></TR><TR><TD ALIGN="LEFT">- supplierEmail : String</TD></TR><TR><TD ALIGN="LEFT">- status : LotStatus</TD></TR><TR><TD ALIGN="LEFT">- customers : List&lt;LotCustomer&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
Product [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#D6F4E8"><B>Product</B></TD></TR><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- name : String</TD></TR><TR><TD ALIGN="LEFT">- description : String</TD></TR><TR><TD ALIGN="LEFT">- categoryId : int</TD></TR><TR><TD ALIGN="LEFT">- unitOfMeasure : String</TD></TR><TR><TD ALIGN="LEFT">- basePrice : BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
}
subgraph cluster_suppliers { label="suppliers/model"; color="#CBD5E0";
CatalogProduct [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFF1CB"><B>CatalogProduct</B></TD></TR><TR><TD ALIGN="LEFT">- productId : int</TD></TR><TR><TD ALIGN="LEFT">- name : String</TD></TR><TR><TD ALIGN="LEFT">- unit : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
PurchaseRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFF1CB"><B>PurchaseRecord</B></TD></TR><TR><TD ALIGN="LEFT">- lotId : int</TD></TR><TR><TD ALIGN="LEFT">- lotNumber : String</TD></TR><TR><TD ALIGN="LEFT">- supplierId : int</TD></TR><TR><TD ALIGN="LEFT">- productName : String</TD></TR><TR><TD ALIGN="LEFT">- entryDate : Timestamp</TD></TR><TR><TD ALIGN="LEFT">- expirationDate : Date</TD></TR><TR><TD ALIGN="LEFT">- initialQuantity : double</TD></TR><TR><TD ALIGN="LEFT">- currentQuantity : double</TD></TR><TR><TD ALIGN="LEFT">- purchasePrice : double</TD></TR><TR><TD ALIGN="LEFT">- lotStatus : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
Supplier [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFF1CB"><B>Supplier</B></TD></TR><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- businessName : String</TD></TR><TR><TD ALIGN="LEFT">- nit : String</TD></TR><TR><TD ALIGN="LEFT">- contactPerson : String</TD></TR><TR><TD ALIGN="LEFT">- email : String</TD></TR><TR><TD ALIGN="LEFT">- phone : String</TD></TR><TR><TD ALIGN="LEFT">- address : String</TD></TR><TR><TD ALIGN="LEFT">- active : boolean</TD></TR><TR><TD ALIGN="LEFT">- registrationDate : Timestamp</TD></TR><TR><TD ALIGN="LEFT">- catalog : List&lt;CatalogProduct&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
SupplierReliability [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFF1CB"><B>SupplierReliability</B></TD></TR><TR><TD ALIGN="LEFT">- supplierId : int</TD></TR><TR><TD ALIGN="LEFT">- totalLots : int</TD></TR><TR><TD ALIGN="LEFT">- totalQuantity : double</TD></TR><TR><TD ALIGN="LEFT">- wastedQuantity : double</TD></TR><TR><TD ALIGN="LEFT">- rejectedInspections : int</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
}
subgraph cluster_sales { label="sales/model"; color="#CBD5E0";
AvailableProduct [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#E2ECFF"><B>AvailableProduct</B></TD></TR><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- name : String</TD></TR><TR><TD ALIGN="LEFT">- unit : String</TD></TR><TR><TD ALIGN="LEFT">- availableQuantity : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- startingPrice : BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
CompanyInfo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#E2ECFF"><B>CompanyInfo</B></TD></TR><TR><TD ALIGN="LEFT">- name : String</TD></TR><TR><TD ALIGN="LEFT">- nit : String</TD></TR><TR><TD ALIGN="LEFT">- address : String</TD></TR><TR><TD ALIGN="LEFT">- phone : String</TD></TR><TR><TD ALIGN="LEFT">- email : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
Customer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#E2ECFF"><B>Customer</B></TD></TR><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- name : String</TD></TR><TR><TD ALIGN="LEFT">- document : String</TD></TR><TR><TD ALIGN="LEFT">- email : String</TD></TR><TR><TD ALIGN="LEFT">- phone : String</TD></TR><TR><TD ALIGN="LEFT">- address : String</TD></TR><TR><TD ALIGN="LEFT">- customerType : CustomerType</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
CustomerType [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#E2ECFF"><B>&lt;&lt;enum&gt;&gt; CustomerType</B></TD></TR><TR><TD ALIGN="LEFT">- dbId : int</TD></TR><TR><TD ALIGN="LEFT">- label : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ fromDbId(int) : CustomerType</TD></TR></TABLE>>];
InvoiceLine [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#E2ECFF"><B>InvoiceLine</B></TD></TR><TR><TD ALIGN="LEFT">- productName : String</TD></TR><TR><TD ALIGN="LEFT">- lotId : int</TD></TR><TR><TD ALIGN="LEFT">- quantity : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- unitPrice : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- discountRate : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- discount : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- taxRate : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- tax : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- subtotal : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- total : BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
SaleItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#E2ECFF"><B>SaleItem</B></TD></TR><TR><TD ALIGN="LEFT">- productId : int</TD></TR><TR><TD ALIGN="LEFT">- quantity : BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
SaleReceipt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#E2ECFF"><B>SaleReceipt</B></TD></TR><TR><TD ALIGN="LEFT">- saleId : int</TD></TR><TR><TD ALIGN="LEFT">- saleNumber : String</TD></TR><TR><TD ALIGN="LEFT">- invoiceNumber : String</TD></TR><TR><TD ALIGN="LEFT">- cufe : String</TD></TR><TR><TD ALIGN="LEFT">- customerName : String</TD></TR><TR><TD ALIGN="LEFT">- customerDocument : String</TD></TR><TR><TD ALIGN="LEFT">- lines : List&lt;InvoiceLine&gt;</TD></TR><TR><TD ALIGN="LEFT">- subtotal : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- discount : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- tax : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- total : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- pdfPath : Path</TD></TR><TR><TD ALIGN="LEFT">- qrPath : Path</TD></TR><TR><TD ALIGN="LEFT">- company : CompanyInfo</TD></TR><TR><TD ALIGN="LEFT">- issuedAt : LocalDateTime</TD></TR><TR><TD ALIGN="LEFT">- customerAddress : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
}
subgraph cluster_logistics { label="logistics/model"; color="#CBD5E0";
DeliveryRoute [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFE4D7"><B>DeliveryRoute</B></TD></TR><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- name : String</TD></TR><TR><TD ALIGN="LEFT">- createdAt : Timestamp</TD></TR><TR><TD ALIGN="LEFT">- createdBy : String</TD></TR><TR><TD ALIGN="LEFT">- estimatedDeparture : Timestamp</TD></TR><TR><TD ALIGN="LEFT">- estimatedArrival : Timestamp</TD></TR><TR><TD ALIGN="LEFT">- actualDeparture : Timestamp</TD></TR><TR><TD ALIGN="LEFT">- actualArrival : Timestamp</TD></TR><TR><TD ALIGN="LEFT">- status : RouteStatus</TD></TR><TR><TD ALIGN="LEFT">- vehicle : Vehicle</TD></TR><TR><TD ALIGN="LEFT">- driver : Driver</TD></TR><TR><TD ALIGN="LEFT">- stops : List&lt;RouteStop&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
DispatchOrder [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFE4D7"><B>DispatchOrder</B></TD></TR><TR><TD ALIGN="LEFT">- saleId : int</TD></TR><TR><TD ALIGN="LEFT">- saleNumber : String</TD></TR><TR><TD ALIGN="LEFT">- customerName : String</TD></TR><TR><TD ALIGN="LEFT">- deliveryAddress : String</TD></TR><TR><TD ALIGN="LEFT">- saleDate : Timestamp</TD></TR><TR><TD ALIGN="LEFT">- totalAmount : double</TD></TR><TR><TD ALIGN="LEFT">- status : DispatchStatus</TD></TR><TR><TD ALIGN="LEFT">- assignedRouteId : int</TD></TR><TR><TD ALIGN="LEFT">- assignedRouteName : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ hasRoute() : boolean</TD></TR></TABLE>>];
DispatchStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFE4D7"><B>&lt;&lt;enum&gt;&gt; DispatchStatus</B></TD></TR><TR><TD ALIGN="LEFT">- dbName : String</TD></TR><TR><TD ALIGN="LEFT">- label : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ next() : DispatchStatus<BR ALIGN="LEFT"/>+ canTransitionTo(DispatchStatus) : boolean<BR ALIGN="LEFT"/>+ fromDbName(String) : DispatchStatus</TD></TR></TABLE>>];
Driver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFE4D7"><B>Driver</B></TD></TR><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- name : String</TD></TR><TR><TD ALIGN="LEFT">- licenseNumber : String</TD></TR><TR><TD ALIGN="LEFT">- phone : String</TD></TR><TR><TD ALIGN="LEFT">- email : String</TD></TR><TR><TD ALIGN="LEFT">- active : boolean</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
RouteStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFE4D7"><B>&lt;&lt;enum&gt;&gt; RouteStatus</B></TD></TR><TR><TD ALIGN="LEFT">- dbName : String</TD></TR><TR><TD ALIGN="LEFT">- label : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ fromDbName(String) : RouteStatus</TD></TR></TABLE>>];
RouteStop [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFE4D7"><B>RouteStop</B></TD></TR><TR><TD ALIGN="LEFT">- saleId : int</TD></TR><TR><TD ALIGN="LEFT">- saleNumber : String</TD></TR><TR><TD ALIGN="LEFT">- deliveryOrder : int</TD></TR><TR><TD ALIGN="LEFT">- destinationAddress : String</TD></TR><TR><TD ALIGN="LEFT">- deliveredAt : Timestamp</TD></TR><TR><TD ALIGN="LEFT">- receivedBy : String</TD></TR><TR><TD ALIGN="LEFT">- status : DispatchStatus</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
Vehicle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFE4D7"><B>Vehicle</B></TD></TR><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- plate : String</TD></TR><TR><TD ALIGN="LEFT">- model : String</TD></TR><TR><TD ALIGN="LEFT">- capacity : double</TD></TR><TR><TD ALIGN="LEFT">- status : VehicleStatus</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ constructor / accessors</TD></TR></TABLE>>];
VehicleStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#AAB8C8"><TR><TD BGCOLOR="#FFE4D7"><B>&lt;&lt;enum&gt;&gt; VehicleStatus</B></TD></TR><TR><TD ALIGN="LEFT">- dbName : String</TD></TR><TR><TD ALIGN="LEFT">- label : String</TD></TR><TR><TD ALIGN="LEFT" BORDER="1" SIDES="T">+ fromDbName(String) : VehicleStatus</TD></TR></TABLE>>];
}
LotTrace -> Lot [label="lot",headlabel="1",arrowhead=vee];
LotTrace -> LotStatus [label="status",headlabel="1",arrowhead=vee];
LotTrace -> LotCustomer [label="customers",headlabel="0..*",dir=both,arrowtail=odiamond,arrowhead=none];
Supplier -> CatalogProduct [label="catalog",headlabel="0..*",dir=both,arrowtail=odiamond,arrowhead=none];
Customer -> CustomerType [label="customerType",headlabel="1",arrowhead=vee];
SaleReceipt -> InvoiceLine [label="lines",headlabel="0..*",dir=both,arrowtail=odiamond,arrowhead=none];
SaleReceipt -> CompanyInfo [label="company",headlabel="1",arrowhead=vee];
DeliveryRoute -> RouteStatus [label="status",headlabel="1",arrowhead=vee];
DeliveryRoute -> Vehicle [label="vehicle",headlabel="1",arrowhead=vee];
DeliveryRoute -> Driver [label="driver",headlabel="1",arrowhead=vee];
DeliveryRoute -> RouteStop [label="stops",headlabel="0..*",dir=both,arrowtail=odiamond,arrowhead=none];
DispatchOrder -> DispatchStatus [label="status",headlabel="1",arrowhead=vee];
RouteStop -> DispatchStatus [label="status",headlabel="1",arrowhead=vee];
Vehicle -> VehicleStatus [label="status",headlabel="1",arrowhead=vee];
Lot -> Product [style=dashed,label="productId",arrowhead=vee];
Lot -> Supplier [style=dashed,label="supplierId",arrowhead=vee];
Inspection -> Lot [style=dashed,label="lotId",arrowhead=vee];
SaleItem -> Product [style=dashed,label="productId",arrowhead=vee];
InvoiceLine -> Lot [style=dashed,label="lotId",arrowhead=vee];
PurchaseRecord -> Lot [style=dashed,label="lotId",arrowhead=vee];
CatalogProduct -> Product [style=dashed,label="productId",arrowhead=vee];
RouteStop -> DispatchOrder [style=dashed,label="saleId",arrowhead=vee];
PurchaseRecord -> Supplier [style=dashed,label="supplierId",arrowhead=vee];
SupplierReliability -> Supplier [style=dashed,label="supplierId",arrowhead=vee];
LotCustomer -> Customer [style=dashed,label="id",arrowhead=vee];
AvailableProduct -> Product [style=dashed,label="id",arrowhead=vee];
Lot -> LotStatus [style=dashed,label="statusId (catalog)",arrowhead=vee];
}